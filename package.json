{
  "name": "dsh-hide-empty-workspace",
  "version": "0.2.0",
  "description": "DSH Web 插件：最后一个未归档会话被归档的瞬间自动隐藏该工作区行，另配右键手动隐藏与侧栏底部恢复入口；只切 display，不归档、不删除、不改写任何工作区注册与会话数据。",
  "type": "module",
  "license": "MIT",
  "author": "d0ublecl1ck",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "screenshots.json",
    "assets/showcase"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "workspace",
    "hide",
    "archive",
    "empty-workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0ublecl1ck/dsh-hide-empty-workspace.git"
  },
  "homepage": "https://github.com/d0ublecl1ck/dsh-hide-empty-workspace#readme",
  "bugs": {
    "url": "https://github.com/d0ublecl1ck/dsh-hide-empty-workspace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/hidden-workspaces.test.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "check-release": "node scripts/check-release.mjs",
    "verify": "npm test && npm run check-release"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
